---
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { club, getDocuments } from '../lib/content';

const documents = await getDocuments();
const current = documents.filter((doc) => !doc.data.archived);
const archived = documents.filter((doc) => doc.data.archived);
const groups = [
  { title: 'Moduli e regolamenti', items: current },
  { title: 'Archivio', items: archived },
];
---

<BaseLayout title="Documenti" description="Moduli di iscrizione, regolamenti e documenti del Circolo Scherma Castelfranco Veneto.">
  <PageHeader title="Documenti">Moduli per iscriversi, regolamenti e documenti del circolo.</PageHeader>

  {
    groups.map((group, index) => (
      <Section title={group.title}>
        <ul class="doc-list">
          {group.items.map((doc) => (
            <li class="doc">
              <div class="doc__text">
                <span class="doc__title">{doc.data.title}</span>
                <span class="muted">
                  {doc.data.year ?? '[anno]'} · {doc.data.format}, {doc.data.sizeKb} KB
                </span>
              </div>
              <a class="doc__download" href={doc.url} download>
                Scarica<span class="visually-hidden"> {doc.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        {index === 0 && (
          <div class="donate">
            <h3>Sostienici con il 5×1000</h3>
            <p>Nella dichiarazione dei redditi indica il codice fiscale del circolo: {club.taxCode ?? '[codice fiscale]'}.</p>
          </div>
        )}
      </Section>
    ))
  }
</BaseLayout>

<style>
  .doc-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .doc {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem 1.25rem;
    padding: 1rem 1.125rem;
    border: var(--border);
    border-radius: var(--radius-s);
    background: var(--color-surface);
  }

  .doc__text {
    display: grid;
    flex: 1 1 16rem;
    gap: 0.125rem;
  }

  .doc__title {
    font-weight: 700;
  }

  .doc__text .muted {
    font-size: 1rem;
  }

  .doc__download {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    padding-inline: 1.375rem;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-weight: 700;
    text-decoration: none;
  }

  .donate {
    display: grid;
    gap: 0.375rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border: var(--border);
    border-radius: var(--radius-l);
    background: var(--color-accent);
    color: #fff;
  }
</style>
