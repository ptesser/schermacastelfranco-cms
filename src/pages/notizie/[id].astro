---
import { render } from 'astro:content';
import Badge from '../../components/ui/Badge.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import FormattedDate from '../../components/ui/FormattedDate.astro';
import MediaImage from '../../components/ui/MediaImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNews, newsCategoryLabels, type NewsEntry } from '../../lib/content';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry, index) => ({
    params: { id: entry.id },
    props: { entry, newer: news[index - 1], older: news[index + 1] },
  }));
}

interface Props {
  entry: NewsEntry;
  newer?: NewsEntry;
  older?: NewsEntry;
}

const { entry, newer, older } = Astro.props;
const { title, date, location, category, image, imageAlt, results } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title}>
  <article class="container article">
    <Breadcrumb items={[{ label: 'Notizie e gare', href: '/notizie/' }]} current={title} />

    <header class="article__header">
      <p class="article__meta">
        <Badge>{newsCategoryLabels[category]}</Badge>
        <FormattedDate date={date} />
        <span>{location}</span>
      </p>
      <h1>{title}</h1>
    </header>

    {
      image && (
        <div class="article__figure">
          <MediaImage src={image} alt={imageAlt} height="clamp(14rem, 8rem + 25vw, 29rem)" sizes="(min-width: 52rem) 50rem, 100vw" priority />
        </div>
      )
    }

    <div class="article__body">
      <Content />
    </div>

    {
      results && results.length > 0 && (
        <section aria-labelledby="results-title" class="stack">
          <h2 id="results-title">Risultati</h2>
          <ul class="results">
            {results.map((result) => (
              <li>
                <strong>{result.athlete}</strong>
                <span>
                  {result.category} · {result.placement}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="article__pager" aria-label="Altre notizie">
      {
        older && (
          <a href={`/notizie/${older.id}/`}>
            <span class="muted">Notizia precedente</span>
            <strong>{older.data.title}</strong>
          </a>
        )
      }
      {
        newer && (
          <a href={`/notizie/${newer.id}/`}>
            <span class="muted">Notizia successiva</span>
            <strong>{newer.data.title}</strong>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .article {
    display: grid;
    gap: var(--space-m);
    max-inline-size: 52rem;
    padding-block: 2rem var(--space-xl);
  }

  .article__header {
    display: grid;
    gap: 0.875rem;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.875rem;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .article__figure :global(.media-image) {
    border: var(--border);
    border-radius: var(--radius-l);
  }

  .article__body {
    max-inline-size: var(--measure);
  }

  .article__body :global(p + p) {
    margin-block-start: 1em;
  }

  .results {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .results li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 1rem 1.125rem;
    border: var(--border);
    border-radius: var(--radius-s);
    background: var(--color-surface);
  }

  .article__pager {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    padding-block-start: 1rem;
    border-block-start: var(--border);
  }

  .article__pager a {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
  }
</style>
