---
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import DefinitionList from '../components/ui/DefinitionList.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { club, telHref } from '../lib/content';

const { contacts, venue, payments, openingHours } = club;
const firstSlot = openingHours[0];
---

<BaseLayout title="Contatti" description="Contatti, sede e orari del Circolo Scherma Castelfranco Veneto.">
  <PageHeader title="Contatti">Per informazioni sui corsi o per una lezione di prova, chiama o scrivi al Maestro.</PageHeader>

  <Section label="Recapiti">
    <div class="grid">
      <Card>
        <h2 class="card-title">{contacts.contactRole}</h2>
        <p>{contacts.contactPerson}</p>
        <div class="actions">
          <Button href={telHref(contacts.phone)}>Chiama {contacts.phone}</Button>
          <Button href={`mailto:${contacts.email}`} variant="secondary">Scrivi a {contacts.email}</Button>
        </div>
        <p class="muted">PEC: {contacts.pec}</p>
      </Card>
      <Card>
        <h2 class="card-title">Sala scherma</h2>
        <p>{venue.address}<br />{venue.city}</p>
        <p>Lunedì – venerdì, {firstSlot?.from} – {firstSlot?.to}</p>
        <p><a href={venue.mapsUrl}>Apri in Google Maps</a></p>
      </Card>
      <Card>
        <h2 class="card-title">Dati del circolo</h2>
        <DefinitionList
          items={[
            { term: 'Nome', value: club.name },
            { term: 'C.F.', value: club.taxCode },
            { term: 'IBAN', value: payments.iban },
          ]}
        />
      </Card>
    </div>
  </Section>
</BaseLayout>

<style>
  .card-title {
    font-size: 1.5rem;
  }

  .actions {
    display: grid;
    gap: 0.75rem;
  }
</style>
