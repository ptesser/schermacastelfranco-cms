---
import { getCollection, render } from 'astro:content';
import FormattedDate from '../components/ui/FormattedDate.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((entry) => ({ params: { legal: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, updated, draft } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title}>
  <PageHeader title={title}>
    {draft ? 'Bozza in revisione. ' : ''}Ultimo aggiornamento: <FormattedDate date={updated} />.
  </PageHeader>
  <Section label={title}>
    <div class="prose">
      <Content />
    </div>
  </Section>
</BaseLayout>

<style>
  .prose {
    max-inline-size: var(--measure);
  }

  .prose :global(:where(p, ul) + *) {
    margin-block-start: 1rem;
  }

  .prose :global(h2) {
    margin-block: 2rem 0.75rem;
    font-size: 1.625rem;
  }

  .prose :global(h3) {
    margin-block: 1.5rem 0.5rem;
    font-size: 1.25rem;
  }

  .prose :global(ul) {
    padding-inline-start: 1.25rem;
  }

  .prose :global(li + li) {
    margin-block-start: 0.375rem;
  }
</style>
