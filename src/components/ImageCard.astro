---
import type { ImageMetadata } from 'astro';
import Card from './ui/Card.astro';
import MediaImage from './ui/MediaImage.astro';

interface Props {
  title: string;
  image?: ImageMetadata | null;
  imageAlt?: string | null;
  placeholder?: string;
  fallback?: ImageMetadata;
  /** Makes the title a link. */
  href?: string;
  /** Link opens an external site: shows an icon and a screen reader hint. */
  external?: boolean;
  imageHeight?: string;
  imageAspectRatio?: string;
  imagePosition?: string;
}

const { title, image, imageAlt, placeholder, fallback, href, external = false, imageHeight = '14rem', imageAspectRatio, imagePosition } =
  Astro.props;
---

<Card as="article" flush>
  <MediaImage
    src={image}
    alt={imageAlt}
    fallback={fallback}
    placeholder={placeholder}
    height={imageHeight}
    aspectRatio={imageAspectRatio}
    position={imagePosition}
    widths={[320, 640, 960]}
    sizes="(min-width: 60rem) 24rem, 100vw"
    class="image-card__media"
  />
  <div class="image-card__body">
    <h3 class="image-card__title">
      {
        href ? (
          <a href={href} rel={external ? 'noopener' : undefined}>
            {title}
            {external && (
              <>
                <svg aria-hidden="true" class="image-card__external" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
                <span class="visually-hidden"> (sito esterno)</span>
              </>
            )}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <slot />
  </div>
</Card>

<style>
  .image-card__body {
    display: grid;
    gap: 0.25rem;
    padding: 1.125rem;
    border-block-start: var(--border);
  }

  .image-card__title {
    font-size: 1.25rem;
  }

  .image-card__title a {
    text-decoration: none;
  }

  .image-card__title a:hover {
    text-decoration: underline;
  }

  /* Whole card is clickable through the title link. */
  .image-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .image-card__external {
    display: inline-block;
    margin-inline-start: 0.25rem;
    vertical-align: -0.1em;
  }

</style>
