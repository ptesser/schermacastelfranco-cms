---
import { legalNav } from '../../config/navigation';
import { club, getLinks } from '../../lib/content';

const links = await getLinks();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="stack" style="--stack-gap: 0.375rem">
      <p class="site-footer__name">{club.name}</p>
      <p>C.F. {club.taxCode ?? '[codice fiscale]'}</p>
      <p>PEC {club.contacts.pec}</p>
    </div>

    <nav aria-label="Federazioni ed enti">
      <ul class="site-footer__list">
        {links.map((link) => <li><a href={link.data.url}>{link.data.name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Note legali">
      <ul class="site-footer__list">
        {legalNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <p class="container site-footer__copy">© {year} {club.name}</p>
</footer>

<style>
  .site-footer {
    background: #111;
    color: #fff;
    font-size: 1rem;
    padding-block: var(--space-l) var(--space-m);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }

  .site-footer__name {
    font-size: 1.375rem;
    font-weight: 800;
  }

  .site-footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    display: inline-block;
    padding-block: 0.5rem;
    color: #fff;
  }

  .site-footer a:hover {
    color: var(--color-accent-on-dark);
  }

  .site-footer :focus-visible {
    outline-color: #fff;
  }

  .site-footer__copy {
    margin-block-start: var(--space-m);
    color: #c9c9c4;
    font-size: var(--text-sm);
  }
</style>
