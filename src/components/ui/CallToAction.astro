---
import Button from './Button.astro';
import Section from './Section.astro';

interface Props {
  title: string;
  href: string;
  label: string;
}

const { title, href, label } = Astro.props;
---

<Section tone="accent">
  <div class="cta">
    <h2 class="cta__title">{title}</h2>
    <Button href={href} variant="secondary">{label}</Button>
  </div>
</Section>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .cta__title {
    max-inline-size: 30ch;
    font-size: clamp(1.625rem, 1.25rem + 1.5vw, 2.25rem);
  }
</style>
