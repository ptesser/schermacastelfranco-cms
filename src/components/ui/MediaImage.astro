---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata | null;
  alt?: string | null;
  /** Decorative image used when `src` is missing. */
  fallback?: ImageMetadata;
  /** Placeholder text shown when there is neither `src` nor `fallback`. */
  placeholder?: string;
  /** Rendered height; the image is cropped to fill it. Ignored when `aspectRatio` is set. */
  height?: string;
  /** Fixed proportions instead of a height, e.g. `4 / 5` for portraits. */
  aspectRatio?: string;
  /** Focal point when cropping, e.g. `center 20%`. */
  position?: string;
  widths?: number[];
  sizes?: string;
  /** Set on the page's main (LCP) image only. */
  priority?: boolean;
  class?: string;
}

const {
  src: source,
  alt: sourceAlt = '',
  fallback,
  placeholder = 'Foto',
  height = '13rem',
  aspectRatio,
  position = 'center',
  widths = [400, 800, 1200],
  sizes = '(min-width: 60rem) 33vw, 100vw',
  priority = false,
  class: className,
} = Astro.props;

const src = source ?? fallback;
const alt = source ? sourceAlt : '';
const style = aspectRatio
  ? `--media-aspect: ${aspectRatio}; --media-position: ${position}`
  : `--media-height: ${height}; --media-position: ${position}`;
---

{
  src ? (
    <Image
      src={src}
      alt={alt ?? ''}
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      class:list={['media-image', className]}
      style={style}
    />
  ) : (
    <div class:list={['media-image', 'media-image--empty', className]} style={style} aria-hidden="true">
      [{placeholder}]
    </div>
  )
}

<style>
  .media-image {
    inline-size: 100%;
    block-size: var(--media-height, auto);
    aspect-ratio: var(--media-aspect, auto);
    object-fit: cover;
    object-position: var(--media-position, center);
  }

  .media-image--empty {
    display: grid;
    place-items: center;
    background: var(--color-muted-bg);
    font-size: var(--text-sm);
  }
</style>
