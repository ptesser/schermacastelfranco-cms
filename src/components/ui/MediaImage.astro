---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata | null;
  alt?: string | null;
  /** Placeholder text shown when there is no image. */
  placeholder?: string;
  /** Rendered height; the image is cropped to fill it. */
  height?: string;
  widths?: number[];
  sizes?: string;
  /** Set on the page's main (LCP) image only. */
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt = '',
  placeholder = 'Foto',
  height = '13rem',
  widths = [400, 800, 1200],
  sizes = '(min-width: 60rem) 33vw, 100vw',
  priority = false,
  class: className,
} = Astro.props;
---

{
  src ? (
    <Image
      src={src}
      alt={alt ?? ''}
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      class:list={['media-image', className]}
      style={`--media-height: ${height}`}
    />
  ) : (
    <div class:list={['media-image', 'media-image--empty', className]} style={`--media-height: ${height}`} aria-hidden="true">
      [{placeholder}]
    </div>
  )
}

<style>
  .media-image {
    inline-size: 100%;
    block-size: var(--media-height);
    object-fit: cover;
  }

  .media-image--empty {
    display: grid;
    place-items: center;
    background: var(--color-muted-bg);
    font-size: var(--text-sm);
  }
</style>
